# Omniphony renderer as a systemd user service, shipped disabled by the Studio
# deb and the AUR orender package. Enable it, and start it now, with
#   systemctl --user enable --now omniphony-renderer
# It is the unit Studio's "Install service" writes to ~/.config/systemd/user/
# (which then takes precedence over this file), with Studio's default settings:
# OSC on 127.0.0.1:9000, log level info, input pipe /tmp/orender.pipe. For
# other settings, install the service from Studio, or
#   systemctl --user edit --full omniphony-renderer
# Kept equal to linux_service_unit() by a test in
# omniphony-studio-egui/core/src/host/commands/orender.rs.

[Unit]
Description=Omniphony Renderer
After=graphical-session.target pipewire.service wireplumber.service
Wants=graphical-session.target

[Service]
Type=notify
ExecStart=/usr/bin/orender render /tmp/orender.pipe --continuous --enable-vbap --osc --osc-host 127.0.0.1 --osc-port 9000 --osc-rx-port 9000 --osc-yield
Restart=on-failure
RestartSec=2
KillSignal=SIGINT
TimeoutStopSec=30

[Install]
WantedBy=default.target
