{
  "identifier": "fr.omniphony.studio",
  "productName": "Omniphony Studio",
  "version": "0.4.2",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build && npm run prepare-sidecar"
  },
  "bundle": {
    "active": true,
    "icon": ["icons/icon.ico", "icons/icon.png", "icons/icon.icns"],
    "externalBin": ["binaries/orender"],
    "resources": {
      "../../layouts/*.yaml": "layouts/",
      "../../layouts/legacy/*.yaml": "layouts/legacy/",
      "binaries/engine/*": "engine/"
    },
    "windows": {
      "nsis": {
        "installMode": "both"
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  },
  "app": {
    "windows": [
      {
        "title": "Omniphony Studio",
        "width": 1400,
        "height": 900
      }
    ],
    "security": {
      "csp": null
    }
  }
}
