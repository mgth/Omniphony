{
  "manifest_version": 3,
  "name": "Omniphony IAMF capture (prototype)",
  "version": "0.2.0",
  "description": "Captures the IAMF audio track YouTube's TV client plays, saves it for orender or streams it to orender live through a native messaging host.",
  "key": "",
  "minimum_chrome_version": "153",
  "permissions": [
    "declarativeNetRequest",
    "scripting",
    "nativeMessaging",
    "storage"
  ],
  "host_permissions": [
    "https://www.youtube.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "tv_page",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "iamf-mp4.js",
        "page-hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "relay.js"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Omniphony IAMF capture"
  }
}
